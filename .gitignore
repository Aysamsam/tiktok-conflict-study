# ---------------------------------------------------------------------------
# Files that must NEVER enter version control.
# ---------------------------------------------------------------------------

# The real credentials file. This is the single most important line here:
# committing .env would leak the institution's TikTok API secret.
.env

# Collected research data. Excluded for three reasons:
#   1. Size - video files quickly reach many gigabytes.
#   2. Ethics - the dataset contains personal data (usernames, comment text)
#      and must live only on approved storage, not on a code host.
#   3. Reproducibility - the code reproduces the data; the data is an output.
data/*.csv
downloads/videos/*.mp4
logs/*.log

# Keep the empty directories themselves in the repository so that a fresh
# clone has the correct structure before the first run.
!data/.gitkeep
!downloads/videos/.gitkeep
!logs/.gitkeep

# Standard Python artefacts.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
