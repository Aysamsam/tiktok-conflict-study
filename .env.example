# ===========================================================================
# TikTok Conflict Study - environment configuration TEMPLATE
# ===========================================================================
#
# 1. Copy this file to ".env"   (cp .env.example .env)
# 2. Fill in the real credentials in that copy.
# 3. Never commit the ".env" file - only this template is safe to share.
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. DATA SOURCE SELECTION
# ---------------------------------------------------------------------------
#   mock          - Generates realistic FAKE posts and comments offline.
#                   No network, no credentials, no rate limits.
#   research_api  - The real TikTok Research API (research.tiktok.com).
#                   Requires an approved academic research account.
TIKTOK_CLIENT=mock


# ---------------------------------------------------------------------------
# 2. TIKTOK RESEARCH API CREDENTIALS
# ---------------------------------------------------------------------------
# Ignored while TIKTOK_CLIENT=mock.
#
# The developer portal shows three values; only two are used here:
#   Client ID     - informational only, not used by the OAuth flow.
#   Client key    - USED for authentication. Goes in TIKTOK_CLIENT_KEY.
#   Client secret - USED for authentication. Goes in TIKTOK_CLIENT_SECRET.
# Mixing up the Client ID and the Client key is a common cause of HTTP 401.
TIKTOK_CLIENT_ID=1780486653
TIKTOK_CLIENT_KEY=REPLACE_ME_WITH_REAL_CLIENT_KEY
TIKTOK_CLIENT_SECRET=REPLACE_ME_WITH_REAL_CLIENT_SECRET

# Approved scopes (informational - client_credentials flow sends no scope):
#   research.data.basic  Public TikTok data for research purposes
#   research.data.o18    Data from European users, plus all other public data
#
# Application expires 30 November 2026 - all collection must finish before then.

# API endpoints. Kept configurable since TikTok has versioned these before.
TIKTOK_OAUTH_URL=https://open.tiktokapis.com/v2/oauth/token/
TIKTOK_VIDEO_QUERY_URL=https://open.tiktokapis.com/v2/research/video/query/
TIKTOK_COMMENT_QUERY_URL=https://open.tiktokapis.com/v2/research/video/comment/list/


# ---------------------------------------------------------------------------
# 3. STUDY SCOPE  (the research design parameters)
# ---------------------------------------------------------------------------
# Collection window, inclusive on both ends, ISO format YYYY-MM-DD.
# The API only accepts date ranges up to 30 days; the pipeline splits this
# window into 30-day chunks automatically.
STUDY_START_DATE=2026-04-01
STUDY_END_DATE=2026-07-31

# Hashtags to search for, comma-separated, without the leading "#".
# Treated as an OR set: a post matching any one of them qualifies.
STUDY_HASHTAGS=IsraelIran,IsraelIranWar,Iranwar,Iran

# Free-text keywords, comma-separated. Optional - leave empty to search by
# hashtag only. When set, a post qualifies via hashtags OR keywords (this
# widens the search; it does not require both). At least one of
# STUDY_HASHTAGS/STUDY_KEYWORDS must be non-empty - a hashtag-only,
# keyword-only, or combined search are all valid. Keyword-only is a
# free-text match against the caption, the closest approximation this API
# allows to a TikTok search-bar query (it cannot reproduce TikTok's own
# search ranking).
STUDY_KEYWORDS=

# ISO 639-1 language code(s), comma-separated. "en" = English only, per the
# study protocol; e.g. "en,fa,he" also keeps Farsi and Hebrew captions.
STUDY_LANGUAGE=en

# Ask the Research API for a random sample instead of its default order
# (decreasing video ID - effectively newest-first, since IDs are roughly
# chronological). Without this, a whole sample can end up clustered in a
# narrow time window even across a wide date range. Unverified live whether
# random mode can still be paginated normally or only returns a single
# capped batch - watch the log on first use.
STUDY_RANDOM_ORDER=false

# How the language criterion is enforced:
#   detect - Identify the caption's language locally and drop non-matching
#            posts. Requires the langdetect package.
#   off    - Collect posts in every language and filter during analysis.
#
# The TikTok Research API has no server-side language filter, so this
# happens locally after retrieval, which costs API quota (see
# SEARCH_OVERFETCH_FACTOR below and src/language.py for the full reasoning).
STUDY_LANGUAGE_MODE=detect

# How many posts to collect in total. Start SMALL (20) to validate the
# pipeline end-to-end, then raise it for the full collection run.
STUDY_MAX_POSTS=20

# How many posts to RETRIEVE per post WANTED, to compensate for local
# filtering. 3 means "retrieve up to 60 to end up with 20"; collection still
# stops the moment 20 eligible posts are saved. Raise it if the log shows the
# sample target being missed; set to 1 to disable over-fetching.
SEARCH_OVERFETCH_FACTOR=3

# Maximum number of comments to keep per post.
STUDY_MAX_COMMENTS_PER_POST=200

# Minimum comment_count (as reported by TikTok) a post must have to be
# collected. Posts below this are excluded as ineligible, same as the
# language filter. 0 disables this filter.
STUDY_MIN_COMMENTS=0

# Maximum video length in seconds. Posts longer than this are excluded.
# 0 disables this filter. A duration of 0 on a post itself means the API
# did not report one, and such posts are kept rather than excluded.
STUDY_MAX_VIDEO_DURATION_SECONDS=0

# Keep only posts carrying an AI content label (has_ai_label - either
# creator-disclosed or platform-detected, see README section 3). false
# collects everything regardless of label, which is needed to measure AI
# label PREVALENCE; true instead builds a sample of just the labelled posts.
STUDY_REQUIRE_AI_LABEL=false

# Keep only posts whose author_region is one of these ISO country codes,
# comma-separated (case-insensitive - TikTok returns "US" and "us"
# inconsistently). Empty = no restriction (the default).
STUDY_REQUIRE_REGIONS=

# How candidate posts are selected once there are more eligible posts than
# STUDY_MAX_POSTS needs:
#   none       - keep whichever eligible posts the API returns first.
#   view_count - scan every eligible candidate in the search budget, then
#                keep the highest-view_count ones. Costs the same API quota
#                but takes longer, since nothing can be written until the
#                full scan finishes.
STUDY_SORT_BY=none

# Optional, sort_by=view_count only. Tags that don't qualify a post on their
# own (see STUDY_HASHTAGS) but that get a ranking multiplier when a post
# also carries one - e.g. #fyp, #trending, used alongside a real topic tag
# by creators chasing reach. Leave empty to disable.
STUDY_BOOST_HASHTAGS=
STUDY_BOOST_MULTIPLIER=1.2

# Maximum posts from any one username in the dataset, counted across all
# runs (not just this one). Prevents a few prolific accounts from filling
# the sample. 0 disables this cap.
STUDY_MAX_POSTS_PER_ACCOUNT=0

# With more than one hashtag/keyword, reserve at least this many raw
# candidates per term before round-robin fills the rest of the search
# budget by availability. Guards against a high-supply term crowding a
# low-supply one out of the scanned pool entirely, on top of what
# round-robin alone provides. This is a floor on candidates SCANNED,
# upstream of eligibility filtering (min_comments, duration, etc.) - not a
# hard guarantee on the final saved sample's composition. 0 disables
# reservation (pure round-robin).
STUDY_MIN_POSTS_PER_HASHTAG=0


# ---------------------------------------------------------------------------
# 4. OUTPUT LOCATION
# ---------------------------------------------------------------------------
# The root directory under which data/ is created.
#   Local development (Windows) : leave as "." (the project folder itself)
#   College server (Linux)      : the mounted research share, e.g.
#                                 /mnt/research/tiktok_conflict_study
OUTPUT_ROOT=.


# ---------------------------------------------------------------------------
# 5. SERVER TRANSFER  (used once the college server is provisioned)
# ---------------------------------------------------------------------------
#   none  - Do nothing. Use when OUTPUT_ROOT already IS a mounted share.
#   copy  - Mirror the output tree to SERVER_DEST_PATH via filesystem copy.
#   sftp  - Upload over SSH to SERVER_HOST. Requires `pip install paramiko`.
SERVER_TRANSFER_MODE=none

# Destination directory ON THE SERVER (used by both "copy" and "sftp").
SERVER_DEST_PATH=/mnt/research/tiktok_conflict_study

# SFTP-only settings. Key-based authentication is preferred over a password.
SERVER_HOST=research.example.edu
SERVER_PORT=22
SERVER_USER=your_university_username
SERVER_SSH_KEY_PATH=


# ---------------------------------------------------------------------------
# 6. RUNTIME BEHAVIOUR
# ---------------------------------------------------------------------------
# Seconds to pause between consecutive API calls.
REQUEST_DELAY_SECONDS=1.0

# Maximum API requests per 24 hours (TikTok's documented research quota is
# 1000/day, resetting at 00:00 UTC). The collector stops cleanly at this
# limit and resumes on the next run.
DAILY_REQUEST_QUOTA=1000

# How many times to retry a failed request before giving up on it.
MAX_RETRIES=3

# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
