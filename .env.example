# ===========================================================================
# TikTok Conflict Study - environment configuration TEMPLATE
# ===========================================================================
#
# HOW TO USE THIS FILE
#   1. Make a copy of it named exactly ".env"  (cp .env.example .env)
#   2. Fill in the real credentials in that copy.
#   3. NEVER commit the ".env" file - only this ".env.example" template is
#      safe to share, because it contains placeholder values only.
#
# WHY THIS EXISTS
#   Hard-coding an API key inside a .py file means the key travels with the
#   code: into version control, into the ZIP you email a supervisor, into the
#   university server backups. Environment variables keep the secret separate
#   from the logic, which is standard practice for research code that will be
#   published or peer-reviewed.
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. DATA SOURCE SELECTION
# ---------------------------------------------------------------------------
# Which implementation of the TikTok client should the pipeline use?
#
#   mock          - Generates realistic FAKE posts and comments offline.
#                   No network, no credentials, no rate limits. Use this for
#                   developing and for demonstrating the pipeline to
#                   reviewers without touching real user data.
#
#   research_api  - The real TikTok Research API (research.tiktok.com).
#                   Requires an approved academic research account and the
#                   client key/secret issued with it.
#
# Switching between the two requires changing this ONE line - no code edits.
TIKTOK_CLIENT=mock


# ---------------------------------------------------------------------------
# 2. TIKTOK RESEARCH API CREDENTIALS
# ---------------------------------------------------------------------------
# These are ignored entirely while TIKTOK_CLIENT=mock.
#
# Copy these from your TikTok for Developers app page. Note that the page shows
# THREE values and only two are used here:
#
#   Client ID     - the numeric app identifier (e.g. 1780486653). Informational
#                   only; the OAuth flow does not use it. Recorded below purely
#                   so the dataset can be traced to the application that
#                   produced it.
#   Client key    - USED for authentication. Goes in TIKTOK_CLIENT_KEY.
#   Client secret - USED for authentication. Goes in TIKTOK_CLIENT_SECRET.
#
# Mixing up the Client ID and the Client key is a common cause of a confusing
# HTTP 401 on the very first request.
TIKTOK_CLIENT_ID=1780486653
TIKTOK_CLIENT_KEY=REPLACE_ME_WITH_REAL_CLIENT_KEY
TIKTOK_CLIENT_SECRET=REPLACE_ME_WITH_REAL_CLIENT_SECRET

# Approved scopes for this application (informational - the client_credentials
# flow does not send a scope parameter; access is granted by the approval):
#   research.data.basic  Public TikTok data for research purposes
#   research.data.o18    Data from European users, plus all other public data
#
# APPLICATION EXPIRY: 30 November 2026. All collection must finish before this
# date or access will stop mid-run. The study window ends 31 July 2026, which
# leaves four months of margin - but re-collection or follow-up waves must be
# planned around it.

# API endpoints. Kept configurable because TikTok has versioned these before
# (v1 -> v2) and a version bump should not require a code change.
TIKTOK_OAUTH_URL=https://open.tiktokapis.com/v2/oauth/token/
TIKTOK_VIDEO_QUERY_URL=https://open.tiktokapis.com/v2/research/video/query/
TIKTOK_COMMENT_QUERY_URL=https://open.tiktokapis.com/v2/research/video/comment/list/


# ---------------------------------------------------------------------------
# 3. STUDY SCOPE  (the research design parameters)
# ---------------------------------------------------------------------------
# Collection window, inclusive on both ends, in ISO format YYYY-MM-DD.
# NOTE: the TikTok Research API only accepts date ranges up to 30 days long.
# The pipeline automatically splits this window into 30-day chunks, so you can
# safely write the full 4-month study period here.
STUDY_START_DATE=2026-04-01
STUDY_END_DATE=2026-07-31

# Hashtags to search for, comma-separated, WITHOUT the leading "#".
# The API treats these as an OR set: a post matching any one of them qualifies.
STUDY_HASHTAGS=IsraelIran,IsraelIranWar,Iranwar,Iran

# ISO 639-1 language code. "en" = English only, per the study protocol.
STUDY_LANGUAGE=en

# How the language criterion is enforced:
#
#   detect - Identify the caption's language locally and drop non-matching
#            posts. Requires the langdetect package (in requirements.txt).
#   off    - Collect posts in every language and filter during analysis.
#            Useful for a pilot, or if you would rather keep the raw sample
#            broad and make the language decision later.
#
# IMPORTANT: the TikTok Research API has NO server-side language filter - its
# video-query endpoint accepts conditions on only eleven fields, none of which
# describes language. Filtering therefore happens locally, AFTER posts are
# retrieved, which means non-English posts still consume API quota. Budget for
# this: if roughly half of hashtag matches are non-English, collecting 1000
# English posts costs about 2000 posts' worth of quota.
#
# See src/language.py for why filtering by region_code was rejected as an
# alternative (it would systematically exclude English-language posts from
# Iran and Israel - among the most important cases in this study).
STUDY_LANGUAGE_MODE=detect

# How many posts to collect in total. Start SMALL (20) to validate the
# pipeline end-to-end, then raise it for the full collection run.
STUDY_MAX_POSTS=20

# How many posts to RETRIEVE per post WANTED, to compensate for local
# filtering. Because the language criterion is applied after retrieval, some
# fetched posts are discarded; without over-fetching, a target of 20 posts
# would yield fewer than 20.
#
# 3 means "retrieve up to 60 to end up with 20". Collection still stops the
# moment 20 eligible posts are saved, so this is an upper bound on effort, not
# a fixed cost. Raise it if the log shows the sample target being missed;
# lower it to 1 to disable over-fetching.
SEARCH_OVERFETCH_FACTOR=3

# Maximum number of comments to keep per post. TikTok posts can have hundreds
# of thousands of comments; a cap keeps runtime and storage bounded.
STUDY_MAX_COMMENTS_PER_POST=200


# ---------------------------------------------------------------------------
# 4. OUTPUT LOCATION
# ---------------------------------------------------------------------------
# The single root directory under which data/ and downloads/ are created.
#
#   Local development (Windows) : leave as "." (the project folder itself)
#   College server (Linux)      : set to the mounted research share, e.g.
#                                 /mnt/research/tiktok_conflict_study
#
# Because every path in the codebase is derived from this one value, moving
# the whole dataset to the server is a single-line configuration change.
OUTPUT_ROOT=.

# Should the raw .mp4 video files be downloaded? Videos dominate disk usage
# (roughly 2-5 MB each). Set to false for a metadata-only pilot run.
DOWNLOAD_VIDEOS=true


# ---------------------------------------------------------------------------
# 5. SERVER TRANSFER  (used later, once the college server is provisioned)
# ---------------------------------------------------------------------------
# How finished data should reach the institutional server:
#
#   none  - Do nothing. Files stay wherever OUTPUT_ROOT points. Use this while
#           OUTPUT_ROOT already IS a mounted network share.
#   copy  - Mirror the output tree to SERVER_DEST_PATH using a plain filesystem
#           copy. Correct when the server is mounted as a drive/NFS share.
#   sftp  - Upload over SSH to SERVER_HOST. Requires `pip install paramiko`.
SERVER_TRANSFER_MODE=none

# Destination directory ON THE SERVER (used by both "copy" and "sftp").
SERVER_DEST_PATH=/mnt/research/tiktok_conflict_study

# SFTP-only settings. Key-based authentication is strongly preferred over a
# password, so SERVER_SSH_KEY_PATH is the recommended field to fill.
SERVER_HOST=research.example.edu
SERVER_PORT=22
SERVER_USER=your_university_username
SERVER_SSH_KEY_PATH=


# ---------------------------------------------------------------------------
# 6. RUNTIME BEHAVIOUR
# ---------------------------------------------------------------------------
# Seconds to pause between consecutive API calls. TikTok's research tier
# permits a limited number of requests per minute; this is the simplest way to
# stay under the limit and be a well-behaved API consumer.
REQUEST_DELAY_SECONDS=1.0

# Maximum API requests per 24 hours. TikTok's documented research quota is
# 1000 requests/day (up to ~100,000 records/day), resetting at 00:00 UTC.
#
# The collector counts its own requests and stops cleanly when this is reached,
# rather than running into a wall of HTTP 429s. Everything collected is saved,
# and re-running after the reset resumes exactly where it stopped.
#
# Each request returns up to 100 records, so 1000 requests is a large budget -
# but note that one post costs 1 search request PLUS one comment request per
# 100 comments, so comment collection dominates. A 200-comment cap means up to
# 2 extra requests per post.
DAILY_REQUEST_QUOTA=1000

# How many times to retry a failed request before giving up on it.
MAX_RETRIES=3

# Logging verbosity: DEBUG, INFO, WARNING, ERROR.
# DEBUG prints every API request/response summary - useful when debugging,
# noisy during a real multi-hour collection run.
LOG_LEVEL=INFO
